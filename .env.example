# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
# If both keys exist, Gemini is used by default. Set RESEARCH_PROVIDER=openai to force OpenAI.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview
OPENAI_API_KEY=
# Optional; defaults to gpt-4.1-mini, which supports the Responses web search tool.
OPENAI_MODEL=gpt-4.1-mini
# Optional: gemini or openai. If omitted, Gemini is selected when GEMINI_API_KEY exists.
# RESEARCH_PROVIDER=gemini
