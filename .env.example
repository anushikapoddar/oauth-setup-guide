# Server-only. Never prefix these with NEXT_PUBLIC_ and never commit real values.
# Set RESEARCH_PROVIDER to anthropic, gemini, or openai.
RESEARCH_PROVIDER=anthropic

# Anthropic (Claude) configuration
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Google Gemini configuration (supports Google Search grounding)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3-flash-preview

# OpenAI configuration (supports Responses API with web search tool)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
